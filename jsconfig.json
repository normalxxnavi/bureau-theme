{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "checkJs": true,
    "strict": true,
    "lib": ["ES2022"],
    "types": ["node", "vscode"],
    "maxNodeModuleJsDepth": 0,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.js", "scripts/**/*.js", "scripts/**/*.d.ts", "test/**/*.js"]
}
