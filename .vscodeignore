# Solo entra en el .vsix lo que la extensión necesita en tiempo de ejecución:
# package.json, package.nls*.json, l10n/, themes/, sounds/, dist/ (el código empaquetado),
# images/icon.png, README.md, CHANGELOG.md y LICENSE.
.vscode/**
.github/**
.vscode-test/**
notes/**
.preview/**
node_modules/**
src/**
scripts/**
test/**
test-workspace/**
docs/**
references/**
images/screenshots/**
**/*.map
**/*.ts
.gitignore
jsconfig.json
package-lock.json
.gitattributes
.editorconfig
CONTRIBUTING.md
SECURITY.md
*.vsix
product-icons/svg/**
