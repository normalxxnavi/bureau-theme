      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.to-file.diff",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#86B57E"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.from-file.diff",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#C46A62"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#79A9D1"
      }
    },
    {
      "name": "Diff ranges and headers",
      "scope": [
        "meta.diff.range",
        "meta.diff.header",
        "meta.diff.index",
        "meta.separator.diff"
      ],
      "settings": {
        "foreground": "#8FC1BE"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF6B6B"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E6B04F",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Log error",
      "scope": [
        "token.error-token"
      ],
      "settings": {
        "foreground": "#FF6B6B"
      }
    },
    {
      "name": "Log warning",
      "scope": [
        "token.warn-token"
      ],
      "settings": {
        "foreground": "#E6B04F"
      }
    },
    {
      "name": "Log info",
      "scope": [
        "token.info-token"
      ],
      "settings": {
        "foreground": "#79A9D1"
      }
    },
    {
      "name": "Log debug",
      "scope": [
        "token.debug-token"
      ],
      "settings": {
        "foreground": "#8E8B85"
      }
    }
  ],
