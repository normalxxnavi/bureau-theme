# Nunca ejecutar los scripts de instalación de las dependencias: es la vía
# habitual del malware en npm. Ninguna dependencia de este proyecto los necesita
# (esbuild trae su binario como dependencia opcional). `npm run …` sigue funcionando.
ignore-scripts=true
# Versiones exactas al añadir una dependencia: solo cambian cuando se decide.
save-exact=true
