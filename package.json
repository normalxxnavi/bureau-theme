{
  "name": "bureau-theme",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.7.720102026",
  "preview": true,
  "publisher": "Normalxxnavi",
  "author": {
    "name": "Normalxxnavi"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#121315",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Normalxxnavi/bureau-theme"
  },
  "homepage": "https://github.com/Normalxxnavi/bureau-theme#readme",
  "bugs": {
    "url": "https://github.com/Normalxxnavi/bureau-theme/issues"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "dark theme",
    "light theme",
    "black theme",
    "oled",
    "red",
    "brutalist",
    "file icons",
    "folder icons",
    "icon theme",
    "product icons",
    "color icons",
    "control",
    "control resonant",
    "remedy",
    "control game",
    "game theme",
    "fan theme",
    "federal bureau of control",
    "oldest house",
    "astral plane",
    "bureau",
    "sound effects",
    "typography",
    "font",
    "wcag",
    "accessible"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "bureauTheme.sounds.enabled",
        "bureauTheme.sounds.pack",
        "bureauTheme.sounds.volume",
        "bureauTheme.sounds.onlyWithControlTheme",
        "bureauTheme.sounds.errorTrigger",
        "bureauTheme.sounds.cooldownMs",
        "bureauTheme.sounds.events.startup",
        "bureauTheme.sounds.events.themeActivated",
        "bureauTheme.sounds.events.save",
        "bureauTheme.sounds.events.typing",
        "bureauTheme.sounds.events.newError",
        "bureauTheme.sounds.events.allClear",
        "bureauTheme.sounds.events.buildSuccess",
        "bureauTheme.sounds.events.buildFail",
        "bureauTheme.sounds.events.terminalFail",
        "bureauTheme.sounds.events.debugStart",
        "bureauTheme.sounds.events.breakpoint",
        "bureauTheme.sounds.events.gitCommit"
      ]
    },
    "virtualWorkspaces": true
  },
  "l10n": "./l10n",
  "contributes": {
    "themes": [
      {
        "label": "CONTROL Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/control-dark-color-theme.json"
      },
      {
        "label": "CONTROL Black",
        "uiTheme": "vs-dark",
        "path": "./themes/control-black-color-theme.json"
      },
      {
        "label": "CONTROL Resonant",
        "uiTheme": "vs-dark",
        "path": "./themes/control-resonant-color-theme.json"
      },
      {
        "label": "CONTROL Astral",
        "uiTheme": "vs",
        "path": "./themes/control-astral-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "bureau-icons",
        "label": "Bureau Icons",
        "path": "./icons/bureau-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "bureau-product-icons",
        "label": "Bureau Product Icons",
        "path": "./product-icons/bureau-product-icon-theme.json"
      },
      {
        "id": "bureau-product-icons-color",
        "label": "Bureau Product Icons (Color)",
        "path": "./product-icons/bureau-product-icon-theme-color.json"
      }
    ],
    "commands": [
      {
        "command": "bureauTheme.openOldestHouse",
        "title": "%command.openOldestHouse%",
        "category": "CONTROL",
        "icon": "$(bureau-house)"
      },
      {
        "command": "bureauTheme.toggleSounds",
        "title": "%command.toggleSounds%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.previewSounds",
        "title": "%command.previewSounds%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.openSoundSettings",
        "title": "%command.openSoundSettings%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.soundMenu",
        "title": "%command.soundMenu%",
        "category": "CONTROL",
        "icon": "$(bureau-resonance)"
      },
      {
        "command": "bureauTheme.toggleStatusBarItem",
        "title": "%command.toggleStatusBarItem%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.chooseFont",
        "title": "%command.chooseFont%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.removeFonts",
        "title": "%command.removeFonts%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.openWelcome",
        "title": "%command.openWelcome%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.chooseTheme",
        "title": "%command.chooseTheme%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.applyFullSet",
        "title": "%command.applyFullSet%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.followSystem",
        "title": "%command.followSystem%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.toggleClassified",
        "title": "%command.toggleClassified%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.declassify",
        "title": "%command.declassify%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.toggleAlertLevel",
        "title": "%command.toggleAlertLevel%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.boardMessage",
        "title": "%command.boardMessage%",
        "category": "CONTROL",
        "icon": "$(bureau-board)"
      },
      {
        "command": "bureauTheme.toggleBoardComments",
        "title": "%command.toggleBoardComments%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.boardSettings",
        "title": "%command.boardSettings%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.toggleBoardRandom",
        "title": "%command.toggleBoardRandom%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.musicMenu",
        "title": "%command.musicMenu%",
        "category": "CONTROL",
        "icon": "$(bureau-jukebox)"
      },
      {
        "command": "bureauTheme.musicPlayPause",
        "title": "%command.musicPlayPause%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.musicNext",
        "title": "%command.musicNext%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.musicPrevious",
        "title": "%command.musicPrevious%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.toggleMusic",
        "title": "%command.toggleMusic%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.openSoundtrack",
        "title": "%command.openSoundtrack%",
        "category": "CONTROL"
      }
    ],
    "walkthroughs": [
      {
        "id": "welcome",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "theme",
            "title": "%walkthrough.theme.title%",
            "description": "%walkthrough.theme.description%",
            "media": {
              "svg": "media/walkthrough/theme.svg",
              "altText": "%walkthrough.theme.alt%"
            },
            "completionEvents": [
              "onSettingChanged:workbench.colorTheme",
              "onCommand:bureauTheme.chooseTheme"
            ]
          },
          {
            "id": "fullSet",
            "title": "%walkthrough.fullSet.title%",
            "description": "%walkthrough.fullSet.description%",
            "media": {
              "svg": "media/walkthrough/fullSet.svg",
              "altText": "%walkthrough.fullSet.alt%"
            },
            "completionEvents": [
              "onCommand:bureauTheme.applyFullSet"
            ]
          },
          {
            "id": "icons",
            "title": "%walkthrough.icons.title%",
            "description": "%walkthrough.icons.description%",
            "media": {
              "svg": "media/walkthrough/icons.svg",
              "altText": "%walkthrough.icons.alt%"
            },
            "completionEvents": [
              "onSettingChanged:workbench.iconTheme",
              "onSettingChanged:workbench.productIconTheme"
            ]
          },
          {
            "id": "followSystem",
            "title": "%walkthrough.followSystem.title%",
            "description": "%walkthrough.followSystem.description%",
            "media": {
              "svg": "media/walkthrough/followSystem.svg",
              "altText": "%walkthrough.followSystem.alt%"
            },
            "completionEvents": [
              "onSettingChanged:window.autoDetectColorScheme"
            ]
          },
          {
            "id": "typography",
            "title": "%walkthrough.typography.title%",
            "description": "%walkthrough.typography.description%",
            "media": {
              "svg": "media/walkthrough/typography.svg",
              "altText": "%walkthrough.typography.alt%"
            },
            "completionEvents": [
              "onSettingChanged:bureauTheme.font",
              "onCommand:bureauTheme.chooseFont"
            ]
          },
          {
            "id": "sounds",
            "title": "%walkthrough.sounds.title%",
            "description": "%walkthrough.sounds.description%",
            "media": {
              "svg": "media/walkthrough/sounds.svg",
              "altText": "%walkthrough.sounds.alt%"
            },
            "completionEvents": [
              "onCommand:bureauTheme.soundMenu",
              "onSettingChanged:bureauTheme.sounds.enabled"
            ]
          },
          {
            "id": "music",
            "title": "%walkthrough.music.title%",
            "description": "%walkthrough.music.description%",
            "media": {
              "svg": "media/walkthrough/music.svg",
              "altText": "%walkthrough.music.alt%"
            },
            "completionEvents": [
              "onSettingChanged:bureauTheme.music.enabled",
              "onCommand:bureauTheme.openSoundtrack"
            ]
          },
          {
            "id": "classified",
            "title": "%walkthrough.classified.title%",
            "description": "%walkthrough.classified.description%",
            "media": {
              "svg": "media/walkthrough/classified.svg",
              "altText": "%walkthrough.classified.alt%"
            },
            "completionEvents": [
              "onSettingChanged:bureauTheme.classified.enabled"
            ]
          },
          {
            "id": "alertLevel",
            "title": "%walkthrough.alertLevel.title%",
            "description": "%walkthrough.alertLevel.description%",
            "media": {
              "svg": "media/walkthrough/alertLevel.svg",
              "altText": "%walkthrough.alertLevel.alt%"
            },
            "completionEvents": [
              "onSettingChanged:bureauTheme.alertLevel.enabled"
            ]
          },
          {
            "id": "board",
            "title": "%walkthrough.board.title%",
            "description": "%walkthrough.board.description%",
            "media": {
              "svg": "media/walkthrough/board.svg",
              "altText": "%walkthrough.board.alt%"
            },
            "completionEvents": [
              "onCommand:bureauTheme.boardMessage",
              "onSettingChanged:bureauTheme.board.random",
              "onSettingChanged:bureauTheme.board.comments"
            ]
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "%config.general.title%",
        "order": 0,
        "properties": {
          "bureauTheme.statusBarItem": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.statusBarItem%"
          }
        }
      },
      {
        "title": "%config.font.title%",
        "order": 0,
        "properties": {
          "bureauTheme.font": {
            "type": "string",
            "enum": [
              "none",
              "bureau",
              "resonant",
              "auto"
            ],
            "enumDescriptions": [
              "%config.font.none%",
              "%config.font.bureau%",
              "%config.font.resonant%",
              "%config.font.auto%"
            ],
            "default": "none",
            "scope": "application",
            "markdownDescription": "%config.font%"
          }
        }
      },
      {
        "title": "%config.sounds.title%",
        "order": 1,
        "properties": {
          "bureauTheme.sounds.enabled": {
            "type": "boolean",
            "default": false,
            "order": 0,
            "markdownDescription": "%config.sounds.enabled%"
          },
          "bureauTheme.sounds.pack": {
            "type": "string",
            "enum": [
              "auto",
              "control",
              "resonant"
            ],
            "enumDescriptions": [
              "%config.sounds.pack.auto%",
              "%config.sounds.pack.control%",
              "%config.sounds.pack.resonant%"
            ],
            "default": "auto",
            "order": 1,
            "description": "%config.sounds.pack%"
          },
          "bureauTheme.sounds.volume": {
            "type": "number",
            "default": 80,
            "minimum": 0,
            "maximum": 200,
            "order": 2,
            "description": "%config.sounds.volume%"
          },
          "bureauTheme.sounds.onlyWithControlTheme": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "%config.sounds.onlyWithControlTheme%"
          },
          "bureauTheme.sounds.errorTrigger": {
            "type": "string",
            "enum": [
              "onSave",
              "live"
            ],
            "enumDescriptions": [
              "%config.sounds.errorTrigger.onSave%",
              "%config.sounds.errorTrigger.live%"
            ],
            "default": "onSave",
            "order": 4,
            "description": "%config.sounds.errorTrigger%"
          },
          "bureauTheme.sounds.cooldownMs": {
            "type": "number",
            "default": 1500,
            "minimum": 0,
            "maximum": 10000,
            "order": 5,
            "description": "%config.sounds.cooldownMs%"
          },
          "bureauTheme.sounds.customFolder": {
            "type": "string",
            "default": "",
            "scope": "application",
            "order": 6,
            "markdownDescription": "%config.sounds.customFolder%"
          }
        }
      },
      {
        "title": "%config.events.title%",
        "order": 2,
        "properties": {
          "bureauTheme.sounds.events.startup": {
            "type": "boolean",
            "default": false,
            "order": 0,
            "description": "%config.events.startup%"
          },
          "bureauTheme.sounds.events.themeActivated": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "%config.events.themeActivated%"
          },
          "bureauTheme.sounds.events.save": {
            "type": "boolean",
            "default": false,
            "order": 2,
            "description": "%config.events.save%"
          },
          "bureauTheme.sounds.events.typing": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "%config.events.typing%"
          },
          "bureauTheme.sounds.events.newError": {
            "type": "boolean",
            "default": true,
            "order": 4,
            "description": "%config.events.newError%"
          },
          "bureauTheme.sounds.events.allClear": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "description": "%config.events.allClear%"
          },
          "bureauTheme.sounds.events.buildSuccess": {
            "type": "boolean",
            "default": true,
            "order": 6,
            "description": "%config.events.buildSuccess%"
          },
          "bureauTheme.sounds.events.buildFail": {
            "type": "boolean",
            "default": true,
            "order": 7,
            "description": "%config.events.buildFail%"
          },
          "bureauTheme.sounds.events.terminalFail": {
            "type": "boolean",
            "default": false,
            "order": 8,
            "description": "%config.events.terminalFail%"
          },
          "bureauTheme.sounds.events.debugStart": {
            "type": "boolean",
            "default": true,
            "order": 9,
            "description": "%config.events.debugStart%"
          },
          "bureauTheme.sounds.events.breakpoint": {
            "type": "boolean",
            "default": true,
            "order": 10,
            "description": "%config.events.breakpoint%"
          },
          "bureauTheme.sounds.events.gitCommit": {
            "type": "boolean",
            "default": true,
            "order": 11,
            "description": "%config.events.gitCommit%"
          }
        }
      },
      {
        "title": "%config.protocols.title%",
        "order": 3,
        "properties": {
          "bureauTheme.classified.enabled": {
            "type": "boolean",
            "default": false,
            "order": 0,
            "markdownDescription": "%config.classified.enabled%"
          },
          "bureauTheme.classified.files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              ".env",
              ".env.*",
              "*.env",
              ".envrc",
              ".flaskenv",
              "appsettings*.json",
              "secrets.json",
              "local.settings.json",
              "*.pem",
              "*.key",
              "id_rsa",
              "id_ecdsa",
              "id_ed25519",
              ".npmrc",
              ".pypirc",
              ".netrc",
              "credentials",
              "*.tfvars",
              "web.config",
              "application*.properties",
              "application*.yml",
              "docker-compose*.yml",
              "compose*.yaml"
            ],
            "order": 1,
            "markdownDescription": "%config.classified.files%"
          },
          "bureauTheme.classified.keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "password",
              "passwd",
              "pwd",
              "secret",
              "token",
              "apikey",
              "accesskey",
              "privatekey",
              "clientsecret",
              "connectionstring",
              "credential",
              "signature",
              "dsn"
            ],
            "order": 2,
            "markdownDescription": "%config.classified.keywords%"
          },
          "bureauTheme.alertLevel.enabled": {
            "type": "boolean",
            "default": false,
            "order": 3,
            "markdownDescription": "%config.alertLevel.enabled%"
          },
          "bureauTheme.alertLevel.incursionThreshold": {
            "type": "number",
            "default": 10,
            "minimum": 1,
            "maximum": 1000,
            "order": 4,
            "markdownDescription": "%config.alertLevel.incursionThreshold%"
          },
          "bureauTheme.board.comments": {
            "type": "boolean",
            "default": false,
            "order": 5,
            "markdownDescription": "%config.board.comments%"
          },
          "bureauTheme.board.random": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "order": 6,
            "markdownDescription": "%config.board.random%"
          },
          "bureauTheme.board.timesPerDay": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 24,
            "order": 7,
            "markdownDescription": "%config.board.timesPerDay%"
          },
          "bureauTheme.board.hours": {
            "type": "string",
            "default": "",
            "pattern": "^$|^\\s*\\d{1,2}:\\d{2}\\s*-\\s*\\d{1,2}:\\d{2}\\s*$",
            "patternErrorMessage": "%config.board.hours.error%",
            "order": 8,
            "markdownDescription": "%config.board.hours%"
          },
          "bureauTheme.board.display": {
            "type": "string",
            "enum": [
              "notification",
              "statusBar",
              "both"
            ],
            "enumDescriptions": [
              "%config.board.display.notification%",
              "%config.board.display.statusBar%",
              "%config.board.display.both%"
            ],
            "default": "notification",
            "order": 9,
            "description": "%config.board.display%"
          },
          "bureauTheme.board.source": {
            "type": "string",
            "enum": [
              "all",
              "board",
              "custom"
            ],
            "enumDescriptions": [
              "%config.board.source.all%",
              "%config.board.source.board%",
              "%config.board.source.custom%"
            ],
            "default": "all",
            "order": 10,
            "description": "%config.board.source%"
          },
          "bureauTheme.board.customMessages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "application",
            "order": 11,
            "markdownDescription": "%config.board.customMessages%"
          }
        }
      },
      {
        "title": "%config.music.title%",
        "order": 4,
        "properties": {
          "bureauTheme.music.enabled": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "order": 0,
            "markdownDescription": "%config.music.enabled%"
          },
          "bureauTheme.music.source": {
            "type": "string",
            "enum": [
              "any",
              "spotify"
            ],
            "enumDescriptions": [
              "%config.music.source.any%",
              "%config.music.source.spotify%"
            ],
            "default": "any",
            "order": 1,
            "description": "%config.music.source%"
          },
          "bureauTheme.music.controls": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "description": "%config.music.controls%"
          }
        }
      }
    ],
    "colors": [
      {
        "id": "bureauTheme.classifiedBar",
        "description": "%color.classifiedBar%",
        "defaults": {
          "dark": "editor.foreground",
          "light": "editor.foreground",
          "highContrast": "editor.foreground",
          "highContrastLight": "editor.foreground"
        }
      }
    ],
    "icons": {
      "bureau-resonance": {
        "description": "CONTROL: sounds on (Resonance)",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E025"
        }
      },
      "bureau-resonance-off": {
        "description": "CONTROL: sounds off",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E026"
        }
      },
      "bureau-jukebox": {
        "description": "CONTROL: sound pack (Songmaster Jukebox)",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E027"
        }
      },
      "bureau-cassette": {
        "description": "CONTROL: preview sounds (Ahti's tape)",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E01C"
        }
      },
      "bureau-hotline": {
        "description": "CONTROL: sound events (the Hotline)",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E00E"
        }
      },
      "bureau-dossier": {
        "description": "CONTROL: custom sounds folder",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "bureau-hexnut": {
        "description": "CONTROL: sound settings",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E00D"
        }
      },
      "bureau-safe": {
        "description": "CONTROL: only with CONTROL themes",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E01F"
        }
      },
      "bureau-polaris": {
        "description": "CONTROL: Polaris",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E011"
        }
      },
      "bureau-board": {
        "description": "CONTROL: the Board",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E008"
        }
      },
      "bureau-classified": {
        "description": "CONTROL: Classified mode (values hidden)",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E080"
        }
      },
      "bureau-declassified": {
