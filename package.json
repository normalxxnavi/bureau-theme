{
  "name": "bureau-theme",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.6.0",
  "preview": true,
  "publisher": "Normalxxnavi",
  "author": {
    "name": "Normalxxnavi"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#121315",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Normalxxnavi/bureau-theme"
  },
  "homepage": "https://github.com/Normalxxnavi/bureau-theme#readme",
  "bugs": {
    "url": "https://github.com/Normalxxnavi/bureau-theme/issues"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "dark theme",
    "light theme",
    "black theme",
    "oled",
    "red",
    "brutalist",
    "file icons",
    "folder icons",
    "icon theme",
    "product icons",
    "color icons",
    "control",
    "control resonant",
    "remedy",
    "control game",
    "game theme",
    "fan theme",
    "federal bureau of control",
    "oldest house",
    "astral plane",
    "bureau",
    "sound effects",
    "typography",
    "font",
    "wcag",
    "accessible"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "bureauTheme.sounds.enabled",
        "bureauTheme.sounds.pack",
        "bureauTheme.sounds.volume",
        "bureauTheme.sounds.onlyWithControlTheme",
        "bureauTheme.sounds.errorTrigger",
        "bureauTheme.sounds.cooldownMs",
        "bureauTheme.sounds.statusBarItem",
        "bureauTheme.sounds.events.startup",
        "bureauTheme.sounds.events.themeActivated",
        "bureauTheme.sounds.events.save",
        "bureauTheme.sounds.events.typing",
        "bureauTheme.sounds.events.newError",
        "bureauTheme.sounds.events.allClear",
        "bureauTheme.sounds.events.buildSuccess",
        "bureauTheme.sounds.events.buildFail",
        "bureauTheme.sounds.events.terminalFail",
        "bureauTheme.sounds.events.debugStart",
        "bureauTheme.sounds.events.breakpoint",
        "bureauTheme.sounds.events.gitCommit"
      ]
    },
    "virtualWorkspaces": true
  },
  "l10n": "./l10n",
  "contributes": {
    "themes": [
      {
        "label": "CONTROL Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/control-dark-color-theme.json"
      },
      {
        "label": "CONTROL Black",
        "uiTheme": "vs-dark",
        "path": "./themes/control-black-color-theme.json"
      },
      {
        "label": "CONTROL Resonant",
        "uiTheme": "vs-dark",
        "path": "./themes/control-resonant-color-theme.json"
      },
      {
        "label": "CONTROL Astral",
        "uiTheme": "vs",
        "path": "./themes/control-astral-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "bureau-icons",
        "label": "Bureau Icons",
        "path": "./icons/bureau-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "bureau-product-icons",
        "label": "Bureau Product Icons",
        "path": "./product-icons/bureau-product-icon-theme.json"
      },
      {
        "id": "bureau-product-icons-color",
        "label": "Bureau Product Icons (Color)",
        "path": "./product-icons/bureau-product-icon-theme-color.json"
      }
    ],
    "commands": [
      {
        "command": "bureauTheme.toggleSounds",
        "title": "%command.toggleSounds%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.previewSounds",
        "title": "%command.previewSounds%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.openSoundSettings",
        "title": "%command.openSoundSettings%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.soundMenu",
        "title": "%command.soundMenu%",
        "category": "CONTROL",
        "icon": "$(bureau-resonance)"
      },
      {
        "command": "bureauTheme.toggleSoundStatusBar",
        "title": "%command.toggleSoundStatusBar%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.chooseFont",
        "title": "%command.chooseFont%",
        "category": "CONTROL"
      },
      {
        "command": "bureauTheme.removeFonts",
        "title": "%command.removeFonts%",
        "category": "CONTROL"
      }
    ],
    "configuration": [
      {
        "title": "%config.font.title%",
        "order": 0,
        "properties": {
          "bureauTheme.font": {
            "type": "string",
            "enum": [
              "none",
              "bureau",
              "resonant",
              "auto"
            ],
            "enumDescriptions": [
              "%config.font.none%",
              "%config.font.bureau%",
              "%config.font.resonant%",
              "%config.font.auto%"
            ],
            "default": "none",
            "scope": "application",
            "markdownDescription": "%config.font%"
          }
        }
      },
      {
        "title": "%config.sounds.title%",
        "order": 1,
        "properties": {
          "bureauTheme.sounds.enabled": {
            "type": "boolean",
            "default": false,
            "order": 0,
            "markdownDescription": "%config.sounds.enabled%"
          },
          "bureauTheme.sounds.pack": {
            "type": "string",
            "enum": [
              "auto",
              "control",
              "resonant"
            ],
            "enumDescriptions": [
              "%config.sounds.pack.auto%",
              "%config.sounds.pack.control%",
              "%config.sounds.pack.resonant%"
            ],
            "default": "auto",
            "order": 1,
            "description": "%config.sounds.pack%"
          },
          "bureauTheme.sounds.volume": {
            "type": "number",
            "default": 70,
            "minimum": 0,
            "maximum": 100,
            "order": 2,
            "description": "%config.sounds.volume%"
          },
          "bureauTheme.sounds.onlyWithControlTheme": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "%config.sounds.onlyWithControlTheme%"
          },
          "bureauTheme.sounds.errorTrigger": {
            "type": "string",
            "enum": [
              "onSave",
              "live"
            ],
            "enumDescriptions": [
              "%config.sounds.errorTrigger.onSave%",
              "%config.sounds.errorTrigger.live%"
            ],
            "default": "onSave",
            "order": 4,
            "description": "%config.sounds.errorTrigger%"
          },
          "bureauTheme.sounds.cooldownMs": {
            "type": "number",
            "default": 1500,
            "minimum": 0,
            "maximum": 10000,
            "order": 5,
            "description": "%config.sounds.cooldownMs%"
          },
          "bureauTheme.sounds.customFolder": {
            "type": "string",
            "default": "",
            "scope": "application",
            "order": 6,
            "markdownDescription": "%config.sounds.customFolder%"
          },
          "bureauTheme.sounds.statusBarItem": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.sounds.statusBarItem%",
            "order": 7
          }
        }
      },
      {
        "title": "%config.events.title%",
        "order": 2,
        "properties": {
          "bureauTheme.sounds.events.startup": {
            "type": "boolean",
            "default": false,
            "order": 0,
            "description": "%config.events.startup%"
          },
          "bureauTheme.sounds.events.themeActivated": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "description": "%config.events.themeActivated%"
          },
          "bureauTheme.sounds.events.save": {
            "type": "boolean",
            "default": false,
            "order": 2,
            "description": "%config.events.save%"
          },
          "bureauTheme.sounds.events.typing": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "%config.events.typing%"
          },
          "bureauTheme.sounds.events.newError": {
            "type": "boolean",
            "default": true,
            "order": 4,
            "description": "%config.events.newError%"
          },
          "bureauTheme.sounds.events.allClear": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "description": "%config.events.allClear%"
          },
          "bureauTheme.sounds.events.buildSuccess": {
            "type": "boolean",
            "default": true,
            "order": 6,
            "description": "%config.events.buildSuccess%"
          },
          "bureauTheme.sounds.events.buildFail": {
            "type": "boolean",
            "default": true,
            "order": 7,
            "description": "%config.events.buildFail%"
          },
          "bureauTheme.sounds.events.terminalFail": {
            "type": "boolean",
            "default": false,
            "order": 8,
            "description": "%config.events.terminalFail%"
          },
          "bureauTheme.sounds.events.debugStart": {
            "type": "boolean",
            "default": true,
            "order": 9,
            "description": "%config.events.debugStart%"
          },
          "bureauTheme.sounds.events.breakpoint": {
            "type": "boolean",
            "default": true,
            "order": 10,
            "description": "%config.events.breakpoint%"
          },
          "bureauTheme.sounds.events.gitCommit": {
            "type": "boolean",
            "default": true,
            "order": 11,
            "description": "%config.events.gitCommit%"
          }
        }
      }
    ],
    "icons": {
      "bureau-resonance": {
        "description": "CONTROL: sounds on (Resonance)",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E025"
        }
      },
      "bureau-resonance-off": {
        "description": "CONTROL: sounds off",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E026"
        }
      },
      "bureau-jukebox": {
        "description": "CONTROL: sound pack (Songmaster Jukebox)",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E027"
        }
      },
      "bureau-cassette": {
        "description": "CONTROL: preview sounds (Ahti's tape)",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E01C"
        }
      },
      "bureau-hotline": {
        "description": "CONTROL: sound events (the Hotline)",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E00E"
        }
      },
      "bureau-dossier": {
        "description": "CONTROL: custom sounds folder",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "bureau-hexnut": {
        "description": "CONTROL: sound settings",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E00D"
        }
      },
      "bureau-safe": {
        "description": "CONTROL: only with CONTROL themes",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E01F"
        }
      },
      "bureau-polaris": {
        "description": "CONTROL: Polaris",
        "default": {
          "fontPath": "./product-icons/bureau-product-icons.woff",
          "fontCharacter": "\\E011"
        }
      }
    }
  },
  "scripts": {
    "build": "node src/theme/build.js && node scripts/bundle.js",
    "watch": "node --watch src/theme/build.js",
    "bundle": "node scripts/bundle.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "contrast": "node scripts/contrast.js",
    "validate": "node scripts/validate-keys.js",
    "preview": "node scripts/preview.js",
    "sounds": "node scripts/sounds/generate.js",
    "icons": "node scripts/icons.js",
    "product-icons": "node scripts/product-icons.js",
    "icon": "node scripts/icon.js",
    "screenshots": "node scripts/screenshots/index.js",
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "npm run bundle && node scripts/integration.js",
    "check": "npm run build && npm run typecheck && npm run contrast && npm run validate && npm test",
    "package": "vsce package",
    "install:local": "node scripts/install-local.js",
    "vscode:prepublish": "npm run build && npm run contrast && npm test",
    "generate": "npm run build && node scripts/icons.js && node scripts/product-icons.js",
    "download-vscode": "node scripts/download-vscode.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.93.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2woff": "^3.0.0",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
