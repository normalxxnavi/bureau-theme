<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proyecto mínimo para que la extensión de C# (Roslyn) cargue csharp.cs y
    genere semantic tokens. También sirve para probar los sonidos de build:
    Terminal → Run Task → "dotnet: build".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FederalBureau.Control</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="csharp.cs" />
  </ItemGroup>

</Project>
